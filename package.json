{
  "name": "claude-pet",
  "version": "1.5.2",
  "private": true,
  "main": "main.js",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "resedit": "^3.1.0"
  },
  "productName": "ClaudePet",
  "description": "大肥鱼（cos Claude）AI 桌宠：会聊天、会提醒、会说话的桌面宠物",
  "author": "you2001215",
  "scripts": {
    "start": "electron .",
    "fetch-sherpa": "node scripts/fetch-sherpa.js",
    "prestart": "node scripts/fetch-sherpa.js",
    "dist:win": "node scripts/fetch-sherpa.js win && electron-builder --win",
    "dist:mac": "node scripts/fetch-sherpa.js mac && electron-builder --mac"
  },
  "build": {
    "appId": "com.fanmade.claudepet",
    "productName": "ClaudePet",
    "copyright": "Fan-made, non-commercial",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "ai.js",
      "stickers.js",
      "reminders.js",
      "preload.js",
      "preload-ui.js",
      "voice/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "LICENSES/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "afterPack": "build/afterPack.js",
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.entertainment",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSHighResolutionCapable": true,
        "NSMicrophoneUsageDescription": "用麦克风跟大肥鱼说话（语音在你电脑上识别，不会上传）"
      },
      "extraResources": [
        {
          "from": "vendor/sherpa/sherpa-onnx-node",
          "to": "sherpa/sherpa-onnx-node"
        },
        {
          "from": "vendor/sherpa/sherpa-onnx-darwin-arm64",
          "to": "sherpa/sherpa-onnx-darwin-arm64"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "vendor/sherpa/sherpa-onnx-node",
          "to": "sherpa/sherpa-onnx-node"
        },
        {
          "from": "vendor/sherpa/sherpa-onnx-win-x64",
          "to": "sherpa/sherpa-onnx-win-x64"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claude 桌宠",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "ClaudePet-Setup-${version}.${ext}"
    },
    "electronLanguages": [
      "zh-CN",
      "zh-TW",
      "en-US",
      "en",
      "ja"
    ],
    "publish": null
  },
  "dependencies": {
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/you2001215/claude-pet.git"
  }
}